# ============================================================================
# Python 推理计算服务群 部署配置文件（.env 范例）
# ----------------------------------------------------------------------------
# 使用方法：
#   cp deploy/.env.example .env     # 复制到仓库根目录（与 docker-compose.yml 同级）
#   vi .env                         # 修改下述【必填】项，其余按需覆盖
#   docker compose --project-directory . -f deploy/docker-compose.prod.yml up -d
#
# 配置机制：pydantic-settings，嵌套分隔符 `__`（如 REMOTE__ENDPOINT → remote.endpoint）。
# 所有配置均为 L1 部署配置，改后须重启容器生效（docker compose up -d --force-recreate）。
# URL 类配置项一律为完整 URL（含路径，代码不拼接，启动即校验，非法拒绝启动）。
# 业务策略参数（阈值/配色/类别映射/min_area 等）不在此处——由 Java 逐请求下发（FR-10）。
# ============================================================================

# ===== 【必填】三服务公共：鉴权总开关（FR-10.7） =====
# 必须与 Java 侧环境变量同值注入，否则出现一侧鉴权一侧放行的不一致状态。
# true  = 开启内部令牌校验（所有请求须带 X-Internal-Token 头；/health 恒豁免）
# false = 关闭（仅限全内网受信部署形态，关闭状态会经 Java capabilities 向前端明示）
AUTH_ENABLED=true
INTERNAL_TOKEN=CHANGE_ME_与Java侧一致的共享密钥

# ============================================================================
# infer-service（:8001）
# ============================================================================

# 推理提供方缺省兜底：X-Inference-Provider 头缺省时使用（remote / local-gpu / local-cpu）
# 纯 CPU 服务器：local-cpu；GPU 服务器：local-gpu；走远程推理平台：remote
SERVICE__DEFAULT_PROVIDER=local-cpu

# 模型目录（容器内挂载点，与 compose 的 volume 挂载目标一致，勿随意改）
MODELS__DIR=/models

# 默认模型名与版本（按 {name}/{version}/{fp32,int8}.onnx 组织）
# 联调/演示：指向伪模型 v0.0-fake；生产：指向真实交付版本
MODELS__SEGMENTATION__NAME=landcover-seg
MODELS__SEGMENTATION__VERSION=v0.0-fake
# 分割模型输出类别表（0=背景；与 Java 要素目录 element_catalog 的 model_class_id 对齐）
MODELS__SEGMENTATION__CLASS_IDS=[0,1,2,3,4]
MODELS__CHANGE_DETECTION__NAME=change-detection
MODELS__CHANGE_DETECTION__VERSION=v0.0-fake

# Tile 切分（FR-1.3/6.7）：256 切块、32 重叠（stride=224，保证融合无接缝）
TILING__TILE_SIZE=256
TILING__OVERLAP=32

# 推理并发槽位（信号量；intra_op_num_threads = CPU 核数 / cpu_slots）
CONCURRENCY__CPU_SLOTS=2
CONCURRENCY__GPU_SLOTS=4

# 远程推理平台（FR-5.4/5.6）：完整端点 URL，直调不拼接；留空 = 未配置远程（正常形态）
REMOTE__ENDPOINT=
REMOTE__TIMEOUT_S=25
REMOTE__BATCH_SIZE=8

# 输入规模上限：local-cpu 模式下影像边长超过此值拒绝（INPUT_TOO_LARGE，R-04 兜底）
LIMITS__LOCAL_CPU_MAX_INPUT=2048

# 预签名 URL 拉图超时（秒）
STORAGE_READER__TIMEOUT_S=30

# 配准校验阈值（像素）：双时相整体平移超过此值返回 ALIGNMENT_FAILED（§3.2.5）
ALIGNMENT__MAX_SHIFT_PX=4

# ============================================================================
# compute-service（:8002）：仅端口与日志级别，无模型
# ============================================================================
# SERVICE__PORT=8002
# SERVICE__LOG_LEVEL=INFO

# ============================================================================
# nlp-service（:8003）：FR-9 自然语言解析，可整体裁剪；不配置不阻塞主链路
# ============================================================================

# 内网 LLM 完整 chat completions 端点（OpenAI 兼容协议，httpx 直调）；
# 留空 = LLM 不可用 → 常驻规则解析降级（nlu_provider=rule-based，FR-9.6/9.7）
NLP__LLM_URL=
NLP__LLM_MODEL=qwen2.5-14b-instruct
NLP__LLM_TIMEOUT_S=15

# 进程内熔断器（FR-9.7）：窗口内连续失败达阈值 → 断流 open_duration_s 秒后半开试探
NLP__CIRCUIT__FAILURE_THRESHOLD=5
NLP__CIRCUIT__WINDOW_S=60
NLP__CIRCUIT__OPEN_DURATION_S=30

# 地理编码（amap / baidu / nominatim）：完整端点 URL，仅按 provider 协议拼 query 参数；
# 留空 = 地理编码不可用 → 回退内置地名词典（FR-9.8 部分成功降级）
NLP__GEOCODER_PROVIDER=nominatim
NLP__GEOCODER_URL=
NLP__GEOCODER_KEY=
